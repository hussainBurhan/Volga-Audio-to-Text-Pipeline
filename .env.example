# Copy to .env to override defaults. All values are optional; defaults are shown.

# --- Input limits (our assumptions, not assignment requirements) ---
APP_MAX_UPLOAD_BYTES=20971520        # 20 MiB
APP_MAX_AUDIO_SECONDS=300

# --- Long audio: background jobs (POST /api/v1/transcription-jobs) ---
APP_MAX_JOB_UPLOAD_BYTES=209715200   # 200 MiB
APP_MAX_JOB_AUDIO_SECONDS=3600
APP_MAX_ACTIVE_JOBS=4                # queued + processing; beyond this, 503
APP_JOB_TTL_SECONDS=3600             # finished results are dropped after this

# --- Speech-to-text model ---
APP_STT_MODEL_SIZE=base              # tiny | base | small | medium | large-v3 ...
APP_STT_DEVICE=cpu                   # cpu | cuda | auto
APP_STT_COMPUTE_TYPE=int8            # int8 (CPU) | float16 (GPU) | float32
APP_STT_BEAM_SIZE=5
APP_STT_VAD_FILTER=true              # drop non-speech audio before decoding

# --- Concurrency / backpressure ---
APP_MAX_CONCURRENT_TRANSCRIPTIONS=1  # inference jobs running at once in this process
APP_QUEUE_TIMEOUT_SECONDS=30         # wait this long for a slot, then 503 SERVER_BUSY

# --- Tooling ---
APP_FFMPEG_TIMEOUT_SECONDS=60
# APP_TEMP_DIR=/path/for/staged/uploads   # default: system temp directory
APP_LOG_LEVEL=INFO
